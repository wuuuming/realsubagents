{
  "name": "pi-realsubagents",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal subagent tool for Pi: delegate a self-contained task to a fresh Pi process and get its final report",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "pi": {
    "extensions": [
      "./extensions/realsubagents/index.ts"
    ]
  },
  "files": [
    "src",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.6",
    "typescript": "^7.0.2"
  }
}
